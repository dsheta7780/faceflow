<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mvvm="clr-namespace:FaceFlow.App.Mvvm">

    <!-- ============================ converters ============================ -->
    <mvvm:BoolToVisibility  x:Key="Cv.Bool"/>
    <mvvm:BoolToVisibility  x:Key="Cv.BoolInv" Invert="True"/>
    <mvvm:NullToVisibility  x:Key="Cv.NotNull"/>
    <mvvm:CountToVisibility x:Key="Cv.Count"/>
    <mvvm:PercentToWidth    x:Key="Cv.Pct"/>

    <!-- ============================== palette ============================== -->
    <Color x:Key="C.Bg">#0C0D11</Color>
    <Color x:Key="C.Surface">#14161D</Color>
    <Color x:Key="C.SurfaceAlt">#1B1E27</Color>
    <Color x:Key="C.Elevated">#232733</Color>
    <Color x:Key="C.Border">#2A2E3B</Color>
    <Color x:Key="C.Text">#ECEEF4</Color>
    <Color x:Key="C.TextDim">#8B92A6</Color>
    <Color x:Key="C.TextFaint">#5A6076</Color>
    <Color x:Key="C.Accent">#6E5BF6</Color>
    <Color x:Key="C.AccentHi">#8B7BFF</Color>
    <Color x:Key="C.Good">#2BB673</Color>
    <Color x:Key="C.Warn">#E0A32E</Color>
    <Color x:Key="C.Bad">#E05260</Color>

    <SolidColorBrush x:Key="B.Bg"          Color="{StaticResource C.Bg}"/>
    <SolidColorBrush x:Key="B.Surface"     Color="{StaticResource C.Surface}"/>
    <SolidColorBrush x:Key="B.SurfaceAlt"  Color="{StaticResource C.SurfaceAlt}"/>
    <SolidColorBrush x:Key="B.Elevated"    Color="{StaticResource C.Elevated}"/>
    <SolidColorBrush x:Key="B.Border"      Color="{StaticResource C.Border}"/>
    <SolidColorBrush x:Key="B.Text"        Color="{StaticResource C.Text}"/>
    <SolidColorBrush x:Key="B.TextDim"     Color="{StaticResource C.TextDim}"/>
    <SolidColorBrush x:Key="B.TextFaint"   Color="{StaticResource C.TextFaint}"/>
    <SolidColorBrush x:Key="B.Accent"      Color="{StaticResource C.Accent}"/>
    <SolidColorBrush x:Key="B.AccentHi"    Color="{StaticResource C.AccentHi}"/>
    <SolidColorBrush x:Key="B.Good"        Color="{StaticResource C.Good}"/>
    <SolidColorBrush x:Key="B.Warn"        Color="{StaticResource C.Warn}"/>
    <SolidColorBrush x:Key="B.Bad"         Color="{StaticResource C.Bad}"/>

    <LinearGradientBrush x:Key="B.AccentGrad" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="{StaticResource C.Accent}" Offset="0"/>
        <GradientStop Color="#4A8CF7" Offset="1"/>
    </LinearGradientBrush>

    <FontFamily x:Key="F.Ui">Segoe UI Variable Display, Segoe UI, Inter, sans-serif</FontFamily>
    <FontFamily x:Key="F.Text">Segoe UI Variable Text, Segoe UI, sans-serif</FontFamily>

    <!-- ============================ typography ============================= -->
    <Style x:Key="T.H1" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource F.Ui}"/>
        <Setter Property="FontSize" Value="28"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource B.Text}"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal"/>
    </Style>
    <Style x:Key="T.H2" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource F.Ui}"/>
        <Setter Property="FontSize" Value="17"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource B.Text}"/>
    </Style>
    <Style x:Key="T.Body" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource F.Text}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{StaticResource B.TextDim}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style x:Key="T.Label" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource F.Text}"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource B.TextFaint}"/>
    </Style>
    <Style x:Key="T.Metric" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource F.Ui}"/>
        <Setter Property="FontSize" Value="30"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource B.Text}"/>
    </Style>

    <!-- ============================== buttons ============================= -->
    <Style x:Key="Btn.Base" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource F.Text}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource B.Text}"/>
        <Setter Property="Background" Value="{StaticResource B.Elevated}"/>
        <Setter Property="BorderBrush" Value="{StaticResource B.Border}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="16,9"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" CornerRadius="8"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Margin="{TemplateBinding Padding}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Opacity" Value="0.85"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bd" Property="Opacity" Value="0.65"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="bd" Property="Opacity" Value="0.35"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Btn.Primary" TargetType="Button" BasedOn="{StaticResource Btn.Base}">
        <Setter Property="Background" Value="{StaticResource B.AccentGrad}"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="Foreground" Value="White"/>
    </Style>

    <Style x:Key="Btn.Ghost" TargetType="Button" BasedOn="{StaticResource Btn.Base}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource B.TextDim}"/>
    </Style>

    <Style x:Key="Btn.Danger" TargetType="Button" BasedOn="{StaticResource Btn.Base}">
        <Setter Property="Background" Value="#3A1F26"/>
        <Setter Property="BorderBrush" Value="#5C2B35"/>
        <Setter Property="Foreground" Value="{StaticResource B.Bad}"/>
    </Style>

    <Style x:Key="Btn.Good" TargetType="Button" BasedOn="{StaticResource Btn.Base}">
        <Setter Property="Background" Value="#143427"/>
        <Setter Property="BorderBrush" Value="#1F5138"/>
        <Setter Property="Foreground" Value="{StaticResource B.Good}"/>
    </Style>

    <!-- =========================== nav buttons =========================== -->
    <Style x:Key="Btn.Nav" TargetType="RadioButton">
        <Setter Property="FontFamily" Value="{StaticResource F.Text}"/>
        <Setter Property="FontSize" Value="13.5"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Foreground" Value="{StaticResource B.TextDim}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Margin" Value="10,1"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid>
                        <Border x:Name="bd" CornerRadius="8" Background="Transparent" Padding="14,10">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <Border x:Name="rail" Width="3" HorizontalAlignment="Left" Margin="0,8"
                                CornerRadius="2" Background="{StaticResource B.Accent}" Visibility="Collapsed"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="#1A1D26"/>
                            <Setter Property="Foreground" Value="{StaticResource B.Text}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="#23202F"/>
                            <Setter TargetName="rail" Property="Visibility" Value="Visible"/>
                            <Setter Property="Foreground" Value="{StaticResource B.Text}"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================== inputs ============================= -->
    <Style x:Key="Input" TargetType="TextBox">
        <Setter Property="FontFamily" Value="{StaticResource F.Text}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{StaticResource B.Text}"/>
        <Setter Property="CaretBrush" Value="{StaticResource B.Accent}"/>
        <Setter Property="Background" Value="{StaticResource B.SurfaceAlt}"/>
        <Setter Property="BorderBrush" Value="{StaticResource B.Border}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="12,9"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border CornerRadius="8" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                                      VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter Property="BorderBrush" Value="{StaticResource B.Accent}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource B.TextDim}"/>
        <Setter Property="FontFamily" Value="{StaticResource F.Text}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Margin" Value="0,6"/>
    </Style>

    <Style TargetType="ComboBox">
        <Setter Property="Foreground" Value="{StaticResource B.Text}"/>
        <Setter Property="Background" Value="{StaticResource B.SurfaceAlt}"/>
        <Setter Property="FontFamily" Value="{StaticResource F.Text}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Padding" Value="10,7"/>
    </Style>

    <Style TargetType="Slider">
        <Setter Property="Foreground" Value="{StaticResource B.Accent}"/>
        <Setter Property="IsSnapToTickEnabled" Value="True"/>
    </Style>

    <!-- ============================== cards ============================== -->
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource B.Surface}"/>
        <Setter Property="BorderBrush" Value="{StaticResource B.Border}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="14"/>
        <Setter Property="Padding" Value="20"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <!-- =========================== scroll bars =========================== -->
    <Style TargetType="ScrollBar">
        <Setter Property="Width" Value="10"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="Transparent">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border CornerRadius="5" Background="#333849" Margin="2,0"/>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/>
                            </Track.IncreaseRepeatButton>
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/>
                            </Track.DecreaseRepeatButton>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- =========================== progress bar ========================== -->
    <Style x:Key="Bar" TargetType="ProgressBar">
        <Setter Property="Height" Value="8"/>
        <Setter Property="Foreground" Value="{StaticResource B.AccentGrad}"/>
        <Setter Property="Background" Value="{StaticResource B.Elevated}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Border CornerRadius="4" Background="{TemplateBinding Background}" ClipToBounds="True">
                        <Border x:Name="PART_Indicator" HorizontalAlignment="Left"
                                CornerRadius="4" Background="{TemplateBinding Foreground}"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
