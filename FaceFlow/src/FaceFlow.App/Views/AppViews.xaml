<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="clr-namespace:FaceFlow.App.ViewModels">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/FaceFlow;component/Themes/Dark.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <!-- ===================================================================
         Shared pieces
         =================================================================== -->

    <Style x:Key="PageScroll" TargetType="ScrollViewer">
        <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
        <Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>
        <Setter Property="Padding" Value="34,30,26,30"/>
    </Style>

    <!-- A person card -->
    <DataTemplate x:Key="PersonCard" DataType="{x:Type vm:PersonTile}">
        <Button Width="164" Margin="0,0,16,20" Cursor="Hand"
                Command="{Binding DataContext.Open, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                CommandParameter="{Binding}">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" CornerRadius="14" Background="{StaticResource B.Surface}"
                            BorderBrush="{StaticResource B.Border}" BorderThickness="1" Padding="12">
                        <StackPanel>
                            <Border CornerRadius="10" Height="140" ClipToBounds="True"
                                    Background="{StaticResource B.SurfaceAlt}">
                                <Grid>
                                    <TextBlock Text="?" FontSize="34" Foreground="{StaticResource B.TextFaint}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <Image Source="{Binding Thumb}" Stretch="UniformToFill"/>
                                </Grid>
                            </Border>
                            <TextBlock Text="{Binding Name}" Margin="2,10,0,0" FontSize="13.5"
                                       FontWeight="SemiBold" Foreground="{StaticResource B.Text}"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding CountText}" Margin="2,2,0,0" FontSize="11.5"
                                       Foreground="{StaticResource B.TextFaint}"/>
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource B.Accent}"/>
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource B.SurfaceAlt}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Button.Template>
        </Button>
    </DataTemplate>

    <!-- ===================================================================
         DASHBOARD
         =================================================================== -->
    <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
        <ScrollViewer Style="{StaticResource PageScroll}">
            <StackPanel MaxWidth="1180" HorizontalAlignment="Left">

                <TextBlock Text="Dashboard" Style="{StaticResource T.H1}"/>
                <TextBlock Style="{StaticResource T.Body}" Margin="0,6,0,26"
                           Text="Point FaceFlow at your photo folders. It indexes once, then only ever looks at what changed."/>

                <!-- metrics -->
                <UniformGrid Columns="4" Margin="0,0,0,22">
                    <Border Style="{StaticResource Card}" Margin="0,0,14,0">
                        <StackPanel>
                            <TextBlock Text="PHOTOS INDEXED" Style="{StaticResource T.Label}"/>
                            <TextBlock Text="{Binding Stats.Indexed, StringFormat='{}{0:N0}'}"
                                       Style="{StaticResource T.Metric}" Margin="0,6,0,0"/>
                            <TextBlock Style="{StaticResource T.Body}" FontSize="11.5"
                                       Text="{Binding Stats.Pending, StringFormat='{}{0:N0} waiting'}"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Margin="0,0,14,0">
                        <StackPanel>
                            <TextBlock Text="FACES FOUND" Style="{StaticResource T.Label}"/>
                            <TextBlock Text="{Binding Stats.Faces, StringFormat='{}{0:N0}'}"
                                       Style="{StaticResource T.Metric}" Margin="0,6,0,0"/>
                            <TextBlock Style="{StaticResource T.Body}" FontSize="11.5"
                                       Text="{Binding Stats.NoFacePhotos, StringFormat='{}{0:N0} photos with none'}"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Margin="0,0,14,0">
                        <StackPanel>
                            <TextBlock Text="PEOPLE" Style="{StaticResource T.Label}"/>
                            <TextBlock Text="{Binding Stats.People, StringFormat='{}{0:N0}'}"
                                       Style="{StaticResource T.Metric}" Margin="0,6,0,0"/>
                            <TextBlock Style="{StaticResource T.Body}" FontSize="11.5"
                                       Text="{Binding Stats.NamedPeople, StringFormat='{}{0:N0} named'}"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="NEEDS REVIEW" Style="{StaticResource T.Label}"/>
                            <TextBlock Text="{Binding Stats.NeedsReview, StringFormat='{}{0:N0}'}"
                                       Style="{StaticResource T.Metric}" Margin="0,6,0,0"
                                       Foreground="{StaticResource B.Warn}"/>
                            <Button Content="Open review →" Style="{StaticResource Btn.Ghost}"
                                    Command="{Binding OpenReview}" HorizontalAlignment="Left"
                                    Padding="0,4" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <!-- scan panel -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,22">
                    <StackPanel>
                        <Grid>
                            <StackPanel>
                                <TextBlock Text="{Binding Phase}" Style="{StaticResource T.H2}"/>
                                <TextBlock Text="{Binding Detail}" Style="{StaticResource T.Body}" Margin="0,4,0,0"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                                <Border CornerRadius="7" Padding="10,5" Margin="0,0,10,0"
                                        Background="{StaticResource B.Elevated}">
                                    <TextBlock Text="{Binding AcceleratorText}" FontSize="11.5" FontWeight="SemiBold"
                                               Foreground="{StaticResource B.Good}"/>
                                </Border>
                                <Border CornerRadius="7" Padding="10,5" Background="{StaticResource B.Elevated}">
                                    <TextBlock FontSize="11.5" Foreground="{StaticResource B.TextDim}"
                                               Text="{Binding Rate, StringFormat='{}{0:0.0} photos/sec'}"/>
                                </Border>
                            </StackPanel>
                        </Grid>

                        <ProgressBar Style="{StaticResource Bar}" Margin="0,18,0,0"
                                     Value="{Binding Percent}" Maximum="100"/>

                        <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                            <Button Content="Start scan" Style="{StaticResource Btn.Primary}"
                                    Command="{Binding StartScan}" Margin="0,0,10,0" MinWidth="130"/>
                            <Button Content="Pause / Resume" Style="{StaticResource Btn.Base}"
                                    Command="{Binding PauseScan}" Margin="0,0,10,0"/>
                            <Button Content="Stop" Style="{StaticResource Btn.Ghost}"
                                    Command="{Binding CancelScan}"/>
                        </StackPanel>

                        <TextBlock Style="{StaticResource T.Body}" FontSize="11.5" Margin="0,14,0,0"
                                   Foreground="{StaticResource B.TextFaint}"
                                   Text="Stopping is always safe. Finished photos are committed as they go, so the next scan picks up exactly where this one left off."/>
                    </StackPanel>
                </Border>

                <!-- libraries -->
                <Grid Margin="0,0,0,14">
                    <TextBlock Text="Photo folders" Style="{StaticResource T.H2}" VerticalAlignment="Center"/>
                    <Button Content="+  Add folder" Style="{StaticResource Btn.Primary}"
                            HorizontalAlignment="Right" Command="{Binding AddLibrary}"/>
                </Grid>

                <ItemsControl ItemsSource="{Binding Libraries}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Card}" Padding="18,15" Margin="0,0,0,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding Path}" FontSize="13.5" FontWeight="SemiBold"
                                                   Foreground="{StaticResource B.Text}"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Style="{StaticResource T.Body}" FontSize="11.5" Margin="0,3,0,0"
                                                   Text="{Binding PhotoCount, StringFormat='{}{0:N0} photos indexed'}"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" VerticalAlignment="Center" Margin="16,0"
                                               Style="{StaticResource T.Body}" FontSize="11.5"
                                               Text="{Binding PendingCount, StringFormat='{}{0:N0} pending'}"/>
                                    <Button Grid.Column="2" Content="Remove" Style="{StaticResource Btn.Ghost}"
                                            Padding="12,7"
                                            Command="{Binding DataContext.RemoveLibrary,
                                                      RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

            </StackPanel>
        </ScrollViewer>
    </DataTemplate>

    <!-- ===================================================================
         PEOPLE  (gallery + detail)
         =================================================================== -->
    <DataTemplate DataType="{x:Type vm:PeopleViewModel}">
        <Grid>

            <!-- ============================ gallery =========================== -->
            <DockPanel Visibility="{Binding ShowGallery, Converter={StaticResource Cv.Bool}}">
                <Border DockPanel.Dock="Top" Padding="34,26,26,18">
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="People" Style="{StaticResource T.H1}"/>
                            <TextBlock Text="{Binding CountText}" Style="{StaticResource T.Body}" Margin="0,4,0,0"/>
                        </StackPanel>
                        <TextBox Style="{StaticResource Input}" Width="280" Height="38"
                                 HorizontalAlignment="Right" VerticalAlignment="Center"
                                 Text="{Binding Search, UpdateSourceTrigger=PropertyChanged, Delay=350}"/>
                    </Grid>
                </Border>

                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="34,0,26,26">
                    <ItemsControl ItemsSource="{Binding People}"
                                  ItemTemplate="{StaticResource PersonCard}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>

            <!-- ============================ detail ============================ -->
            <DockPanel Visibility="{Binding ShowDetail, Converter={StaticResource Cv.Bool}}">

                <Border DockPanel.Dock="Top" Padding="34,22,26,18"
                        BorderBrush="{StaticResource B.Border}" BorderThickness="0,0,0,1">
                    <StackPanel>
                        <Button Content="←  Back to People" Style="{StaticResource Btn.Ghost}"
                                HorizontalAlignment="Left" Padding="0,4" Command="{Binding Back}"/>

                        <Grid Margin="0,14,0,0">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="76" Height="76" CornerRadius="14" ClipToBounds="True"
                                        Background="{StaticResource B.SurfaceAlt}">
                                    <Image Source="{Binding Selected.Thumb}" Stretch="UniformToFill"/>
                                </Border>
                                <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding DetailTitle}" Style="{StaticResource T.H1}" FontSize="24"/>
                                    <TextBlock Style="{StaticResource T.Body}" Margin="0,4,0,0"
                                               Text="{Binding Selected.CountText}"/>
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <TextBox Style="{StaticResource Input}" Width="200" Height="38"
                                         VerticalAlignment="Center" Margin="0,0,8,0"
                                         Text="{Binding RenameText, UpdateSourceTrigger=PropertyChanged}"/>
                                <Button Content="Rename" Style="{StaticResource Btn.Base}"
                                        Command="{Binding Rename}" Margin="0,0,8,0"/>
                                <Button Content="Create folder" Style="{StaticResource Btn.Primary}"
                                        Command="{Binding CreateFolder}" Margin="0,0,8,0"/>
                                <Button Content="Split selected" Style="{StaticResource Btn.Base}"
                                        Command="{Binding SplitSelected}" Margin="0,0,8,0"/>
                                <Button Content="Delete" Style="{StaticResource Btn.Danger}"
                                        Command="{Binding DeletePerson}"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Style="{StaticResource T.Body}" FontSize="11.5" Margin="0,12,0,0"
                                   Foreground="{StaticResource B.TextFaint}"
                                   Text="Create folder copies the original full-resolution files into a new folder. Tick tiles and use Split to move wrongly grouped faces into their own person."/>
                    </StackPanel>
                </Border>

                <!-- merge strip -->
                <Border DockPanel.Dock="Bottom" Padding="34,14,26,18"
                        BorderBrush="{StaticResource B.Border}" BorderThickness="0,1,0,0">
                    <StackPanel>
                        <TextBlock Text="MERGE ANOTHER PERSON INTO THIS ONE" Style="{StaticResource T.Label}"/>
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                                      Margin="0,10,0,0" MaxHeight="86">
                            <ItemsControl ItemsSource="{Binding MergeCandidates}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Margin="0,0,8,0" Style="{StaticResource Btn.Base}" Padding="8"
                                                Command="{Binding DataContext.Merge,
                                                          RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}">
                                            <StackPanel Orientation="Horizontal">
                                                <Border Width="34" Height="34" CornerRadius="8" ClipToBounds="True"
                                                        Background="{StaticResource B.SurfaceAlt}">
                                                    <Image Source="{Binding Thumb}" Stretch="UniformToFill"/>
                                                </Border>
                                                <StackPanel Margin="9,0,4,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}" FontSize="12"
                                                               Foreground="{StaticResource B.Text}"/>
                                                    <TextBlock Text="{Binding CountText}" FontSize="10.5"
                                                               Foreground="{StaticResource B.TextFaint}"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </StackPanel>
                </Border>

                <!-- photo grid -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="34,20,26,20">
                    <ItemsControl ItemsSource="{Binding DetailPhotos}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Width="168" Margin="0,0,14,14" CornerRadius="12" Padding="8"
                                        Background="{StaticResource B.Surface}"
                                        BorderBrush="{StaticResource B.Border}" BorderThickness="1">
                                    <StackPanel>
                                        <Grid>
                                            <Border CornerRadius="9" Height="140" ClipToBounds="True"
                                                    Background="{StaticResource B.SurfaceAlt}">
                                                <Image Source="{Binding Thumb}" Stretch="UniformToFill"/>
                                            </Border>
                                            <CheckBox IsChecked="{Binding IsSelected}" Margin="7"
                                                      HorizontalAlignment="Left" VerticalAlignment="Top"/>
                                            <Border CornerRadius="6" Padding="6,2" Margin="7"
                                                    HorizontalAlignment="Right" VerticalAlignment="Top"
                                                    Background="#CC000000">
                                                <TextBlock Text="{Binding ConfidenceText}" FontSize="10"
                                                           Foreground="White"/>
                                            </Border>
                                        </Grid>
                                        <TextBlock Text="{Binding FileName}" FontSize="11" Margin="2,8,0,0"
                                                   Foreground="{StaticResource B.TextDim}"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,7,0,0">
                                            <Button Content="Not this person" FontSize="10.5" Padding="8,5"
                                                    Style="{StaticResource Btn.Danger}" Margin="0,0,5,0"
                                                    Command="{Binding DataContext.RemoveFace,
                                                              RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}"/>
                                            <Button Content="Cover" FontSize="10.5" Padding="8,5"
                                                    Style="{StaticResource Btn.Ghost}"
                                                    Command="{Binding DataContext.SetCover,
                                                              RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>

            <!-- busy overlay -->
            <Border Background="#CC0C0D11" Visibility="{Binding Busy, Converter={StaticResource Cv.Bool}}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="Copying originals..." Style="{StaticResource T.H2}"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding BusyText}" Style="{StaticResource T.Body}" Margin="0,8,0,0"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>
    </DataTemplate>

    <!-- ===================================================================
         REVIEW
         =================================================================== -->
    <DataTemplate DataType="{x:Type vm:ReviewViewModel}">
        <DockPanel>
            <Border DockPanel.Dock="Top" Padding="34,26,26,18">
                <Grid>
                    <StackPanel>
                        <TextBlock Text="Needs Review" Style="{StaticResource T.H1}"/>
                        <TextBlock Style="{StaticResource T.Body}" Margin="0,5,0,0"
                                   Text="Borderline matches. Nothing here affects a person's face signature until you confirm it."/>
                    </StackPanel>
                    <TextBlock Text="{Binding PositionText}" HorizontalAlignment="Right" VerticalAlignment="Center"
                               Style="{StaticResource T.Body}"/>
                </Grid>
            </Border>

            <!-- empty state -->
            <Border Visibility="{Binding IsEmpty, Converter={StaticResource Cv.Bool}}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="◐" FontSize="46" HorizontalAlignment="Center"
                               Foreground="{StaticResource B.TextFaint}"/>
                    <TextBlock Text="Nothing to review" Style="{StaticResource T.H2}" Margin="0,14,0,0"
                               HorizontalAlignment="Center"/>
                    <TextBlock Style="{StaticResource T.Body}" Margin="0,6,0,0" HorizontalAlignment="Center"
                               Text="Every match so far was confident enough to decide automatically."/>
                </StackPanel>
            </Border>

            <Grid Visibility="{Binding HasWork, Converter={StaticResource Cv.Bool}}" Margin="34,0,26,26">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="330"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" CornerRadius="14" Background="{StaticResource B.Surface}"
                        BorderBrush="{StaticResource B.Border}" BorderThickness="1" ClipToBounds="True">
                    <Image Source="{Binding Photo}" Stretch="Uniform" Margin="10"/>
                </Border>

                <StackPanel Grid.Column="1" Margin="18,0,0,0">
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="DETECTED FACE" Style="{StaticResource T.Label}"/>
                            <Border CornerRadius="12" Height="200" Margin="0,10,0,0" ClipToBounds="True"
                                    Background="{StaticResource B.SurfaceAlt}">
                                <Image Source="{Binding FaceCrop}" Stretch="UniformToFill"/>
                            </Border>

                            <TextBlock Text="SUGGESTED" Style="{StaticResource T.Label}" Margin="0,18,0,0"/>
                            <TextBlock Text="{Binding SuggestionText}" Style="{StaticResource T.H2}" Margin="0,5,0,0"/>
                            <TextBlock Text="{Binding ConfidenceText}" Style="{StaticResource T.Body}"
                                       Foreground="{StaticResource B.Warn}" Margin="0,3,0,0"/>

                            <TextBlock Text="{Binding FileText}" Style="{StaticResource T.Body}" FontSize="11.5"
                                       Margin="0,14,0,0" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding FolderText}" Style="{StaticResource T.Body}" FontSize="10.5"
                                       Foreground="{StaticResource B.TextFaint}" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </Border>

                    <Button Content="✓   Yes, this is them" Style="{StaticResource Btn.Good}"
                            Margin="0,14,0,0" Height="44" Command="{Binding Accept}"/>
                    <Button Content="Assign to someone else" Style="{StaticResource Btn.Base}"
                            Margin="0,8,0,0" Height="40" Command="{Binding AssignTo}"/>
                    <Button Content="Create a new person" Style="{StaticResource Btn.Base}"
                            Margin="0,8,0,0" Height="40" Command="{Binding MakeNewPerson}"/>
                    <Button Content="✕   Not a match" Style="{StaticResource Btn.Danger}"
                            Margin="0,8,0,0" Height="40" Command="{Binding Reject}"/>

                    <StackPanel Orientation="Horizontal" Margin="0,16,0,0" HorizontalAlignment="Center">
                        <Button Content="◄ Previous" Style="{StaticResource Btn.Ghost}"
                                Command="{Binding Previous}" Margin="0,0,8,0"/>
                        <Button Content="Skip ►" Style="{StaticResource Btn.Ghost}" Command="{Binding Skip}"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </DockPanel>
    </DataTemplate>

    <!-- ===================================================================
         PHOTOS  /  NO FACES
         =================================================================== -->
    <DataTemplate DataType="{x:Type vm:PhotosViewModel}">
        <DockPanel>
            <Border DockPanel.Dock="Top" Padding="34,26,26,18">
                <Grid>
                    <StackPanel>
                        <TextBlock Text="{Binding Title}" Style="{StaticResource T.H1}"/>
                        <TextBlock Text="{Binding Subtitle}" Style="{StaticResource T.Body}" Margin="0,5,0,0"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBox Style="{StaticResource Input}" Width="260" Height="38" Margin="0,0,10,0"
                                 Text="{Binding Search, UpdateSourceTrigger=PropertyChanged, Delay=400}"/>
                        <Button Content="Create No Faces folder" Style="{StaticResource Btn.Primary}"
                                Command="{Binding ExportNoFaces}"
                                Visibility="{Binding IsNoFaces, Converter={StaticResource Cv.Bool}}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Border DockPanel.Dock="Bottom" Padding="34,10,26,20">
                <StackPanel Orientation="Horizontal">
                    <Button Content="◄ Previous" Style="{StaticResource Btn.Ghost}" Command="{Binding PrevPage}"/>
                    <TextBlock Text="{Binding PageText}" VerticalAlignment="Center" Margin="14,0"
                               Style="{StaticResource T.Body}"/>
                    <Button Content="Next ►" Style="{StaticResource Btn.Ghost}" Command="{Binding NextPage}"/>
                </StackPanel>
            </Border>

            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="34,0,26,0">
                <ItemsControl ItemsSource="{Binding Photos}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Width="180" Margin="0,0,14,14" Cursor="Hand"
                                    Command="{Binding DataContext.OpenInExplorer,
                                              RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    CommandParameter="{Binding}">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="bd" CornerRadius="12" Padding="8"
                                                Background="{StaticResource B.Surface}"
                                                BorderBrush="{StaticResource B.Border}" BorderThickness="1">
                                            <StackPanel>
                                                <Border CornerRadius="9" Height="132" ClipToBounds="True"
                                                        Background="{StaticResource B.SurfaceAlt}">
                                                    <Image Source="{Binding Thumb}" Stretch="UniformToFill"/>
                                                </Border>
                                                <TextBlock Text="{Binding FileName}" FontSize="11" Margin="2,8,0,0"
                                                           Foreground="{StaticResource B.TextDim}"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding FaceCount, StringFormat='{}{0} face(s)'}"
                                                           FontSize="10.5" Margin="2,2,0,0"
                                                           Foreground="{StaticResource B.TextFaint}"/>
                                            </StackPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bd" Property="BorderBrush"
                                                        Value="{StaticResource B.Accent}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </DockPanel>
    </DataTemplate>

    <!-- ===================================================================
         SETTINGS
         =================================================================== -->
    <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
        <ScrollViewer Style="{StaticResource PageScroll}">
            <StackPanel MaxWidth="820" HorizontalAlignment="Left">
                <TextBlock Text="Settings" Style="{StaticResource T.H1}"/>
                <TextBlock Style="{StaticResource T.Body}" Margin="0,6,0,26"
                           Text="Changes apply to the next scan."/>

                <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Performance" Style="{StaticResource T.H2}"/>

                        <TextBlock Style="{StaticResource T.Body}" Margin="0,16,0,4"
                                   Text="{Binding Workers, StringFormat='Worker threads: {0}'}"/>
                        <Slider Minimum="1" Maximum="32" TickFrequency="1"
                                Value="{Binding Workers}"/>
                        <TextBlock Style="{StaticResource T.Body}" FontSize="11" Foreground="{StaticResource B.TextFaint}">
                            <Run Text="Your machine reports"/><Run Text=" "/><Run Text="{Binding CoreCount, Mode=OneWay}"/><Run
                                Text=" logical cores. Leaving one or two free keeps the rest of Windows responsive."/>
                        </TextBlock>

                        <TextBlock Style="{StaticResource T.Body}" Margin="0,20,0,4"
                                   Text="{Binding DecodeMaxDimension, StringFormat='Decode size: {0} px on the long edge'}"/>
                        <Slider Minimum="640" Maximum="3200" TickFrequency="160"
                                Value="{Binding DecodeMaxDimension}"/>
                        <TextBlock Style="{StaticResource T.Body}" FontSize="11" Foreground="{StaticResource B.TextFaint}"
                                   Text="Lower is much faster. Higher finds smaller faces in group shots. This only affects decoding in memory — files on disk are never resized."/>

                        <CheckBox Content="Use the GPU when one is available" IsChecked="{Binding PreferGpu}" Margin="0,18,0,0"/>
                        <CheckBox Content="Generate face thumbnails during the scan" IsChecked="{Binding GenerateThumbnails}"/>

                        <Button Content="Save settings" Style="{StaticResource Btn.Primary}"
                                HorizontalAlignment="Left" Margin="0,18,0,0" Command="{Binding Save}"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Hardware" Style="{StaticResource T.H2}"/>
                        <TextBlock Text="{Binding HardwareText}" Style="{StaticResource T.Body}" Margin="0,10,0,0"/>
                        <TextBlock Text="{Binding ProvidersText, StringFormat='ONNX Runtime providers: {0}'}"
                                   Style="{StaticResource T.Body}" FontSize="11.5" Margin="0,4,0,0"
                                   Foreground="{StaticResource B.TextFaint}"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Storage" Style="{StaticResource T.H2}"/>
                        <TextBlock Text="{Binding DataFolder}" Style="{StaticResource T.Body}" Margin="0,10,0,0"/>
                        <TextBlock Text="{Binding ModelsFolder}" Style="{StaticResource T.Body}" FontSize="11.5"
                                   Foreground="{StaticResource B.TextFaint}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                            <Button Content="Open data folder" Style="{StaticResource Btn.Base}"
                                    Command="{Binding OpenDataFolder}" Margin="0,0,8,0"/>
                            <Button Content="Open models folder" Style="{StaticResource Btn.Base}"
                                    Command="{Binding OpenModelsFolder}" Margin="0,0,8,0"/>
                            <Button Content="Open logs" Style="{StaticResource Btn.Ghost}"
                                    Command="{Binding OpenLogs}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Maintenance" Style="{StaticResource T.H2}"/>
                        <TextBlock Style="{StaticResource T.Body}" Margin="0,10,0,0"
                                   Text="Neither of these touches your photo files. They only affect FaceFlow's own cache and index."/>
                        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                            <Button Content="Clear thumbnail cache" Style="{StaticResource Btn.Base}"
                                    Command="{Binding ClearThumbnails}" Margin="0,0,8,0"/>
                            <Button Content="Reset index" Style="{StaticResource Btn.Danger}"
                                    Command="{Binding ResetIndex}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </DataTemplate>

</ResourceDictionary>
